{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cf-chat-app",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-22",
  // nodejs_compat is required by the `pg` driver used to reach Neon via Hyperdrive.
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "9f91441982644c9a95246cf76e6c7be9",
    },
  ],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Config id only. The Neon credentials live in the Hyperdrive config on
      // Cloudflare's side, set once at `wrangler hyperdrive create` time.
      "id": "516d5b5a80ae45ada647976484e3dcdb",
      // Local dev reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
      // from the environment rather than a connection string committed here.
    },
  ],

  // ADR-007. `destinations` is deliberately absent until the OTLP destination
  // open item in docs/plan.md is settled; traces still land in the dashboard.
  "observability": {
    "traces": {
      "enabled": true,
    },
    "logs": {
      "enabled": true,
    },
  },
}

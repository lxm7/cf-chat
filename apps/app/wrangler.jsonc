{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cf-chat-app",
  // Points at our own module, not "@tanstack/react-start/server-entry". That
  // package export is a self-contained default entry: it builds its own handler
  // and never imports src/server.ts, so pointing `main` at it silently drops the
  // Hono API and any named exports. See ADR-003.
  "main": "./src/server.ts",
  "compatibility_date": "2026-08-22",
  // nodejs_compat is required by postgres.js (the `postgres` package, chosen in
  // ADR-009), which reaches Neon through the Hyperdrive binding over a raw TCP
  // socket and so needs node:net, node:tls and node:crypto.
  "compatibility_flags": ["nodejs_compat"],

  // ADR-005: the model id is config, never a literal in the loop. The gateway
  // id is here for the same reason, and because AI Gateway is where spend
  // limits and per-tenant metadata live.
  //
  // Kimi K2.5 was deprecated on 30 May 2026 and Cloudflare aliases those
  // requests to K2.6, so this names K2.6 directly rather than relying on an
  // alias that will eventually be withdrawn. See the ADR-005 amendment.
  "vars": {
    "REPLY_MODEL_ID": "@cf/moonshotai/kimi-k2.6",
    "AI_GATEWAY_ID": "default"
  },

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "9f91441982644c9a95246cf76e6c7be9"
    }
  ],

  // The reply loop. Private to `app`: the widget reaches it over a service
  // binding rather than holding a cross-script stub (ADR-008).
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION",
        "class_name": "Conversation"
      }
    ]
  },

  // `new_sqlite_classes`, not `new_classes`: AIChatAgent stores messages and
  // buffers stream chunks in SQLite, and the Agents SDK requires the SQLite
  // backend. Getting this wrong fails at deploy, not at runtime.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Conversation"]
    }
  ],

  "r2_buckets": [
    {
      "binding": "KNOWLEDGE",
      "bucket_name": "cf-chat-knowledge"
    }
  ],

  // Workers AI, used by the ingest consumer for `toMarkdown`. AI Search caps
  // files at 4MB; converting anything larger (or any PDF) to markdown first
  // brings it back under the cap and improves chunking. See ADR-011.
  "ai": {
    "binding": "AI"
  },

  // Namespace binding rather than an instance binding: instances are created
  // per tenant at runtime, which the instance binding cannot do. Requires a
  // compatibility date of 2026-03-27 or later. `remote` because AI Search has
  // no local emulation, so `vite dev` proxies to the real service; tests use
  // FixtureIndexer and never reach this binding.
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "INGEST",
        "queue": "cf-chat-ingest"
      },
      {
        "binding": "ANALYTICS",
        "queue": "cf-chat-analytics"
      }
    ],
    "consumers": [
      {
        "queue": "cf-chat-ingest",
        // Each message can spend up to 30s in uploadAndPoll, so a full batch
        // is ~150s sequential, well inside the 15 minute consumer wall clock.
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "cf-chat-ingest-dlq"
      },
      {
        // The same Worker consumes the dead letter queue, dispatched on
        // `batch.queue`. Without a consumer these messages die silently and the
        // row stays `uploaded` or `indexing` forever. The handler only writes a
        // terminal status, so batches can be larger and finish in milliseconds.
        "queue": "cf-chat-ingest-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // No dead_letter_queue of its own: this is the end of the line. A
        // message that fails three status writes here is dropped, and the cron
        // sweep in build step 8 is what eventually notices the row.
        "max_retries": 3
      },
      {
        // Turn records, written after the visitor already has their reply.
        // Nothing is waiting on these, so the batch is large and the timeout
        // long: one transaction per turn is the cost worth amortising.
        "queue": "cf-chat-analytics",
        "max_batch_size": 25,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "cf-chat-analytics-dlq"
      },
      {
        // Consumed only so a lost turn record says so in a log rather than
        // vanishing. There is nothing to repair: unlike a source row, the
        // analytics row *is* the record.
        "queue": "cf-chat-analytics-dlq",
        "max_batch_size": 25,
        "max_batch_timeout": 30,
        "max_retries": 1
      }
    ]
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Config id only. The Neon credentials live in the Hyperdrive config on
      // Cloudflare's side, set once at `wrangler hyperdrive create` time.
      "id": "516d5b5a80ae45ada647976484e3dcdb"
      // Local dev reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
      // from the environment rather than a connection string committed here.
    }
  ],

  // ADR-007. `destinations` is deliberately absent until the OTLP destination
  // open item in docs/plan.md is settled; traces still land in the dashboard.
  "observability": {
    "traces": {
      "enabled": true
    },
    "logs": {
      "enabled": true
    }
  }
}

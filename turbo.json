{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["cf-typegen"]
    },
    "test": {},
    "cf-typegen": {
      "outputs": ["worker-configuration.d.ts"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
